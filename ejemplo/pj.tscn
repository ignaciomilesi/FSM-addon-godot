[sub_resource type="GDScript" id="GDScript_g1avn"]
resource_name = "DE_PIE"
script/source = "@tool

extends Grupo

func revisar_grupo() -> void:
	if Input.is_action_pressed(\"agachar\"):
		cambiarEstado.emit(LISTA_ESTADOS.AGACHADO)
"

[sub_resource type="GDScript" id="GDScript_dnv1s"]
resource_name = "IDLE-DE-PIE"
script/source = "extends State

func entrar() -> void:
	animaciones.play(LISTA_NOMBRE_ANIMACIONES.IDLE)
	
func revisar() -> void:
	var direccion = Input.get_axis(\"left\", \"right\")
	if direccion:
		cambiarEstado.emit(LISTA_ESTADOS.CORRER)

func ejecutar() -> void:
	if abs(player.velocity.x) < player.ACCELERACION_MOVIMIENTO:
		player.velocity.x = 0
	
	if abs(player.velocity.x) != 0:
		if player.velocity.x > 0:
			player.velocity.x += -player.ACCELERACION_MOVIMIENTO
		else:
			player.velocity.x += player.ACCELERACION_MOVIMIENTO
 
func salir() -> void:
	pass
"

[sub_resource type="GDScript" id="GDScript_43tq0"]
resource_name = "CORRER-DE-PIE"
script/source = "extends State

func entrar() -> void:
	animaciones.play(LISTA_NOMBRE_ANIMACIONES.CORRER)

func revisar() -> void:
	var direccion = Input.get_axis(\"left\", \"right\")
	if not direccion:
		cambiarEstado.emit(LISTA_ESTADOS.IDLE)

func ejecutar() -> void:
	var direccion = Input.get_axis(\"left\", \"right\")
	
	if direccion:
		player.velocity.x += direccion * player.ACCELERACION_MOVIMIENTO 
		if abs(player.velocity.x) > player.VELOCIDAD_MOVIMIENTO:
			player.velocity.x = direccion * player.VELOCIDAD_MOVIMIENTO
 
func salir() -> void:
	pass
"

[sub_resource type="GDScript" id="GDScript_jpcsl"]
resource_name = "AGACHADO"
script/source = "@tool

extends Grupo

func entrar_grupo() -> void:
	pass

func revisar_grupo() -> void:
	if not Input.is_action_pressed(\"agachar\"):
		cambiarEstado.emit(LISTA_ESTADOS.DE_PIE)

func ejecutar_grupo() -> void:
	pass
"

[sub_resource type="GDScript" id="GDScript_o6150"]
resource_name = "IDLE-AGACHADO"
script/source = "extends State

func entrar() -> void:
	animaciones.play(LISTA_NOMBRE_ANIMACIONES.AGACHADO_IDLE)

func revisar() -> void:
	var direccion = Input.get_axis(\"left\", \"right\")
	if direccion:
		cambiarEstado.emit(LISTA_ESTADOS.CORRER)

func ejecutar() -> void:
	if abs(player.velocity.x) < player.ACCELERACION_MOVIMIENTO:
		player.velocity.x = 0
	
	if abs(player.velocity.x) != 0:
		if player.velocity.x > 0:
			player.velocity.x += -player.ACCELERACION_MOVIMIENTO
		else:
			player.velocity.x += player.ACCELERACION_MOVIMIENTO
 
func salir() -> void:
	pass
"

[sub_resource type="GDScript" id="GDScript_50fl7"]
resource_name = "CORRER-AGACHADO"
script/source = "extends State

func entrar() -> void:
	animaciones.play(LISTA_NOMBRE_ANIMACIONES.AGACHADO_MOVER)

func revisar() -> void:
	var direccion = Input.get_axis(\"left\", \"right\")
	if not direccion:
		cambiarEstado.emit(LISTA_ESTADOS.IDLE)

func ejecutar() -> void:
	var direccion = Input.get_axis(\"left\", \"right\")
	
	if direccion:
		player.velocity.x += direccion * player.ACCELERACION_MOVIMIENTO 
		if abs(player.velocity.x) > player.VELOCIDAD_MOVIMIENTO / player.FACTOR_AGACHADO:
			player.velocity.x = direccion * player.VELOCIDAD_MOVIMIENTO / player.FACTOR_AGACHADO
 
func salir() -> void:
	pass
"

[sub_resource type="GDScript" id="GDScript_8mwpu"]
resource_name = "MIRAR-DER"
script/source = "extends State

@export var ani : AnimatedSprite2D

func entrar() -> void:
	ani.scale.x = 1

func revisar() -> void:
	var direccion : float = Input.get_axis(\"left\", \"right\")
	if direccion < 0:
		cambiarEstado.emit(LISTA_ESTADOS.IZQUIERDA)

func ejecutar() -> void:
	pass
 
func salir() -> void:
	pass
"

[sub_resource type="GDScript" id="GDScript_6hwmu"]
resource_name = "MIRAR-IZQ"
script/source = "extends State

@export var ani : AnimatedSprite2D

func entrar() -> void:
	ani.scale.x = -1

func revisar() -> void:
	var direccion : float = Input.get_axis(\"left\", \"right\")
	if direccion > 0:
		cambiarEstado.emit(LISTA_ESTADOS.DERECHA)

func ejecutar() -> void:
	pass
 
func salir() -> void:
	pass
"

