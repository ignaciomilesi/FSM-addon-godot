resource_name = "IDLE"
script/source = "extends State

func entrar() -> void:
	player.velocity = Vector2(0,0)
	animaciones.play(\"IDLE\")

func revisar() -> void:
	pass
	# devido a que el cambio de animacion se realiza en el AnimationPlayer
