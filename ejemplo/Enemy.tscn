	# if -A- tiempoAnimacion: cambiarEstado.emit(\"SEARCH\")
"

[sub_resource type="GDScript" id="GDScript_mf5cc"]
resource_name = "SEARCH"
script/source = "extends State

func entrar() -> void:
	player.velocity = Vector2(0,0)
	animaciones.play(\"SEARCH\")

func revisar() -> void:
	if player.get_node(\"SEE\").is_colliding() :
		cambiarEstado.emit(\"DASH\")

func ejecutar() -> void:
	player.rotate(0.05)
"

[sub_resource type="GDScript" id="GDScript_0o5ty"]
resource_name = "DASH"
script/source = "extends State

func entrar() -> void:
	animaciones.play(\"DASH\")

func revisar() -> void:
	if player.is_on_wall():
		player.position += player.velocity.normalized() * -5
		cambiarEstado.emit(\"IDLE\")

func atacar():
	player.velocity = Vector2.RIGHT.rotated(player.rotation) * 600

# cuando pego contra el pj
func _on_area_2d_body_entered(body):
	body.empujar(player.velocity.normalized() * 1000)
		
	player.velocity = player.velocity.normalized() * -1000
	cambiarEstado.emit(\"PUSH\")
"

[sub_resource type="GDScript" id="GDScript_0jkvw"]
resource_name = "PUSH"
script/source = "extends State

func entrar() -> void:
	animaciones.play(\"PUSH\")
	
func revisar() -> void:
	if player.velocity.length() < 100:
		cambiarEstado.emit(\"IDLE\")

func ejecutar() -> void:
	player.velocity = player.velocity.lerp(Vector2.ZERO, 0.2)
"

[sub_resource type="GDScript" id="GDScript_bcmf2"]
resource_name = "Rojo"
script/source = "extends State

func entrar() -> void:
	player.modulate = Color(\"Red\")

func revisar() -> void:
	
	if player.rotation > PI:
		cambiarEstado.emit(\"Azul\")
"

[sub_resource type="GDScript" id="GDScript_yaalq"]
resource_name = "Azul"
script/source = "extends State

func entrar() -> void:
	player.modulate = Color(\"Blue\")

func revisar() -> void:
	
	if player.rotation > 0:
		cambiarEstado.emit(\"Rojo\")
"

