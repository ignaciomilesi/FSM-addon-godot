[gd_scene format=3 uid="uid://dqnki1s2q7cjs"]

[sub_resource type="GDScript" id="GDScript_tjtcp"]
script/source = "@tool
extends GraphFrame

@export var tamaño = Vector2(200,100)

@onready var color_marco = Color.from_hsv(randf(), 0.5, 0.6)

func _ready():
	
#	size = tamaño
	
	var color =  Color(color_marco, 0.2)
	tint_color = color
	resizable = true
	
	for nodo : Node in $GraphEdit.get_children():
		if nodo is GraphNode:
			nodo.self_modulate = color_marco
	
	


func agregar_estado(estado :Node) -> void:
	$GraphEdit.add_child(estado)
	
func obtener_estados() -> Array[Node]:
	return $GraphEdit.get_children()
	
func obtener_estado(nombre :String) -> Node:
	return $GraphEdit.get_node(nombre)

func verificar_existencia_estado(nombre :String) -> bool:
	return $GraphEdit.has_node(nombre)
"

