[ext_resource type="Texture2D" uid="uid://cgxvjenr7gnxe" path="res://addons/FSM/utils/ConectorSimple.png" id="1_rxlut"]

[sub_resource type="GDScript" id="GDScript_pg5ax"]
script/source = "@tool
extends Line2D

@export var EstadoInicio : GraphElement
@export var EstadoFin : GraphElement
@export var GrupoContenedor : GraphElement


var conectorAnim = preload(\"res://addons/FSM/utils/ConectorAnim.png\")
var conectorSeñal = preload(\"res://addons/FSM/utils/ConectorSeñal.png\")

func _ready():
	var color =  Color.from_hsv(randf(), 0.5, 1)
	default_color = color
	$Label.self_modulate = color
	$Label.pivot_offset = $Label.size / 2 # para que el punto de rotacion quede en el centro del label

func set_tipo_conector(tipo):
	if tipo == \"Anim\":
		texture = conectorAnim
	if tipo == \"Señal\":
		texture = conectorSeñal

func _process(_delta):
	if EstadoInicio == null or EstadoFin == null:
		return
	
	var centroEstadoInicio : Vector2 = EstadoInicio.position + EstadoInicio.size * EstadoInicio.scale / 2
	var centroEstadoFin : Vector2 =  EstadoFin.position + EstadoFin.size * EstadoFin.scale /2
	
	var vectorCentroCentro : Vector2 = centroEstadoFin - centroEstadoInicio
	
	var factorBordeInicio : float = min(
		(EstadoInicio.size.x * EstadoInicio.scale.x / 2)/abs(vectorCentroCentro.x), 
		(EstadoInicio.size.y * EstadoInicio.scale.y / 2)/abs(vectorCentroCentro.y))-0.02
	
	var factorBordeFin : float = min(
		(EstadoFin.size.x * EstadoFin.scale.x / 2)/abs(vectorCentroCentro.x), 
		(EstadoFin.size.y * EstadoFin.scale.y / 2)/abs(vectorCentroCentro.y))-0.02
	
	var posicionInicialConector : Vector2 = centroEstadoInicio + vectorCentroCentro * factorBordeInicio
	var posicionFinalConector : Vector2 = centroEstadoFin - vectorCentroCentro * factorBordeFin
	
	if GrupoContenedor != null:
		posicionInicialConector *= GrupoContenedor.scale
		posicionFinalConector *= GrupoContenedor.scale
		
		posicionInicialConector += GrupoContenedor.position  + Vector2(0,40) * GrupoContenedor.scale
		posicionFinalConector += GrupoContenedor.position  + Vector2(0,40) * GrupoContenedor.scale
	
	set_point_position(0, posicionInicialConector)
	set_point_position(1, posicionFinalConector)
	
	# Acomodo el label 
	$Label.position = (posicionInicialConector +
	 (posicionFinalConector - posicionInicialConector) *0.3 # para que quede un poco corrido del medio de la linea
	- $Label.size/2 #acomodo por el tamaño del label
	- (posicionFinalConector - posicionInicialConector).normalized().rotated(PI/2)* 10)
	# lo ultimo es porque el nodo linea posee un ancho de 24 y la linea dibujada se encuentra
	# sobre el extremo superior, tengo que corregir para que el label quede sobre la linea dibujada
	
	# ajusto la escala de la etiqueta
	$Label.scale = EstadoInicio.scale if GrupoContenedor == null else GrupoContenedor.scale
	
	\"\"\"
	# giro el texto para que quede sobre la linea
	var anguloConector = (posicionFinalConector - posicionInicialConector).angle()
	$Label.rotation = anguloConector
	# lo 180º si me queda de cabeza
	if anguloConector < -PI/2 or anguloConector > PI/2:
		$Label.rotation += PI
		\"\"\"

func set_label_condicion(condicion):
	$Label.text = condicion
"

